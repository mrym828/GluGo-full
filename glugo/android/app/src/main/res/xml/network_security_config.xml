<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext (plain HTTP) is only allowed for the local dev backend hosts.
  Everything else — including the production API once API_BASE_URL points
  at a real domain — requires HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.255.2.248</domain>
        <domain includeSubdomains="false">192.168.0.105</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
